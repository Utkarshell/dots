{
    "position": "top",

    "modules-left": [
        "custom/applauncher",
        "sway/window"
    ],

    "modules-center": [
        "sway/workspaces"
    ],

    "modules-right": [
        "tray",    
        "wireplumber",
        "cpu",
        "memory",
        "battery",
        "bluetooth",
        "network",       
        "clock"
    ],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "tooltip": false,
        "persistent-workspaces": {
        "1": [],
        "2": [],
        "3": [],
        "4": [],
        "5": [],
        "6": []
        }
    },

    "custom/applauncher": {
        "format": "",
        "on-click": "pgrep wofi >/dev/null 2>&1 && killall wofi || wofi --show drun --location=top -y 15",
        "tooltip": false
    },
    
    "clock": {
        "format": "{:%I:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
         "format": {
           "today": "<span color='#75f1fa'><b>{}</b></span>"
        }
      }
    },

    "battery": {
        "interval": 60,
        "format": "{icon} {capacity}% ",
        "format-icons": {
            "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
        }
        
    },

    "network": {
        "format-wifi": "",
        "format-disconnected": "󰖪",
        "format-ethernet": "ethernet",
        "tooltip-format": "{ifname} via {gwaddr} 󰊗",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
        "tooltip-format-ethernet": "{ifname} ",
        "tooltip-format-disconnected": "󰖪",
        "max-length": 50,
        "on-click": "exec kitty --title=wifi -e nmtui"
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "", 
        "format-connected": " ",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "exec blueman-manager"
    },

    "wireplumber": {
        "format": " {volume}",
        "format-muted": " ",
        "tooltip": false
    },

    "cpu": {
        "format": " {usage}%",
        "interval": 10,
        "max-length": 10,
        "on-click": "exec kitty --title=btop -e btop"

    },

    "memory": {
		"format": "󰘚 {used}GB",
		"tooltip-format": "{percentage}% memory used\n{swapUsed} GB swap used\n{avail} GB memory available",
		"interval": 30,
        "on-click": "exec kitty --title=htop -e htop"
       
    },
    "tray": {
		"show-passive-items": true,
		"spacing": 10
	},
    "sway/window": {
    "format": "{title}",
    "max-length": 50,  
    "rewrite": {
        "^(.*) - YouTube - Brave$": " $1",
        "^(.*) - Spotify - Brave$": " $1",
        "^(.*) - Brave$": "󰖟 $1",
        "(.*) - zsh": "> [$1]"
    }
    }

    
}