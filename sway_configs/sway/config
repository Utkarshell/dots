
### Variables

set $mod Mod1
set $win Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
set $term kitty
set $file_explorer nautilus
set $browser brave-browser
set $application_launcher pgrep wofi >/dev/null 2>&1 && killall wofi || wofi --show drun


include /etc/sway/config-vars.d/*

# Example configuration:
#
#   output HDMI-A-1 resolution 1920x1080 position 1920,0
#
# You can get the names of your outputs by running: swaymsg -t get_outputs

### Idle configuration
# upgraded version doesnt go to sleep while using vlc/ spotify etc!

exec swayidle -w \
    timeout 180 '~/.local/bin/media-playing || ~/.local/bin/random-lock' \
    timeout 600 '~/.local/bin/media-playing || swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep '~/.local/bin/random-lock'

# before install playerctl || playerctl -p vlc status

### Input configuration

input type:touchpad {
   dwt enabled
   tap enabled
   natural_scroll enabled
   middle_emulation enabled
}

### Key bindings

# title border
default_border pixel 3
default_floating_border pixel 2

# Gaps between windows
gaps inner 7px
gaps outer 2px

# the border color

# class                 border   background text     indicator child_border
client.focused          #BD93F9  #44475A   #F8F8F2 #BD93F9  #BD93F9
client.focused_inactive #6272A4  #282A36   #F8F8F2 #6272A4  #6272A4
client.unfocused        #282A36  #21222C   #BFBFBF #282A36  #282A36
client.urgent           #FF5555  #FF5555   #F8F8F2 #FF5555  #FF5555
client.placeholder      #282A36  #21222C   #F8F8F2 #282A36  #282A36


# Keybinds

bindsym $mod+Return exec $term
bindsym $mod+q kill
bindsym $win+space exec $application_launcher
bindsym $mod+Shift+c reload
bindsym $mod+e exec $file_explorer
bindsym $mod+Shift+space floating toggle

# open app as utk convenience
bindsym $win+w exec $browser
bindsym $win+f exec firefox
bindsym $win+C exec code
bindsym $win+N exec obsidian
bindsym $win+b exec exec blueman-manager
bindsym $win+shift+l exec swaylock

# wallpaper 
bindsym $win+Shift+r exec ~/.local/bin/random-walls

#screenshots
bindsym $win+shift+s exec grim -g "$(slurp)" ~/Pictures/screenshot-$(date +%Y-%m-%d_%H-%M-%S).png
#bindsym $mod+shift+p exec grim ~/Pictures/fullscreen-$(date +%Y-%m-%d_%H-%M-%S).png

# shut down quickly
bindsym $mod+Shift+q exec systemctl poweroff

# Exit sway (logs you out of your Wayland session)
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'


floating_modifier $mod normal




# Moving around
bindsym $mod+f fullscreen
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right



